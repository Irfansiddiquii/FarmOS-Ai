# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Automatically injected at runtime with the Cloud Run service URL.
APP_URL=""

# Cryptographic secret used to sign and validate user role signatures server-side.
# Please generate a secure random 32-character or 64-character string (e.g. openssl rand -base64 32).
ROLE_SECRET=""

# Supabase - Public Client API configuration (Safe for browser/client bundle)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase - Secret Service Role Key (NEVER expose to browser/client bundle)
SUPABASE_SERVICE_ROLE_KEY=""
